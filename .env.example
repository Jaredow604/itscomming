# ==========================================
# It's Coming - Variables de Entorno
# ==========================================
# Copia este archivo como .env y completa los valores.

# --- Django ---
DJANGO_SECRET_KEY=""
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=""

# --- Base de Datos PostgreSQL ---
DB_URL="postgresql://usuario:password@localhost:5432/itscoming_db"
DB_NAME="itscoming_db"
DB_USER="usuario"
DB_PASSWORD="password"
DB_HOST="localhost"
DB_PORT="5432"

# --- LLM Agent (Google Gemini) ---
GEMINI_API_KEY=""

# --- LLM Agent (Groq) ---
GROQ_API_KEY=""

# --- Deportes/Odds ---
ODDS_API_KEY=""

# --- Celery / Redis ---
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/1"
